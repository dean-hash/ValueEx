# Optional tokens
GITHUB_TOKEN=
YOUTUBE_API_KEY=
# Route API base (override if needed)
ROUTE_API=http://127.0.0.1:8000

# Monetization & offers
OFFERS_YAML=config/offers.yaml
MIN_PRIORITY=0.35
MONETIZE_SHADOW=1
LEADS_V2_ONLY=0

# Affiliates (Fiverr)
# Optional: override the subtracking parameter key appended to Fiverr links.
# Default is "afp". Only change if your affiliate account specifies a different key.
# FIVERR_SUB_PARAM=afp

# Runner -> App metrics authentication
INGEST_METRICS_KEY=change-me-strong-key

# LLM triage (optional, env-gated). Default provider is 'ollama'.
LLM_TRIAGE=0
LLM_PROVIDER=ollama
LLM_TRIAGE_CENTER=0.5
LLM_TRIAGE_WINDOW=0.1

# Ollama local settings
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Groq cloud settings (set when you have a key)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# SMTP/Mailer settings (for scripts/send_cli.py and mailer/sender.py)
# Set either a provider like Brevo or Gmail SMTP. Leave blank to use dryrun only.
# SENDER_DOMAIN=example.com  # e.g., alerion.ai
# SMTP_HOST=smtp.gmail.com   # or smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SSL=0                # 1 to force SMTPS/465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com  # defaults to no-reply@SENDER_DOMAIN
# SMTP_NAME=ValueX
# Optional unsubscribe headers
# UNSUBSCRIBE_ADDRESS=unsubscribe@example.com
# UNSUBSCRIBE_URL=https://example.com/unsubscribe?e={email}

# Future toggles (not used yet)
DRY_RUN=1
SHADOW_POST=0

